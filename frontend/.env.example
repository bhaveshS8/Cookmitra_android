# Copy to .env (gitignored) and fill in. Never commit real values.
# All backend requests target the production API.
API_BASE_URL=https://cookmitra.org/api
# Public web origin for shared links (reviews); same value the website serves.
WEB_ORIGIN=https://cookmitra.org
# Razorpay public key id only (rzp_test_* for staging). NEVER put secrets here.
RAZORPAY_KEY_ID=
